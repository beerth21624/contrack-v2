# Backend for the Robot E2E suite (local only). Port 4200, database contrack_e2e. No real secrets here.
NODE_ENV=development
PORT=4200
PERSISTENCE=postgres
DATABASE_URL=postgres://contrack:contrack@localhost:5432/contrack_e2e
REALTIME_BUS=memory
JWT_ACCESS_SECRET=robot-e2e-local-secret-robot-e2e-local-secret
CORS_ORIGINS=http://localhost:3200
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/auth
TRUST_PROXY=loopback
MODULES_ENABLED=subcontracting,workforce
PUBLIC_APP_URL=http://localhost:3200
FILE_STORAGE=local
FILE_STORAGE_DIR=C:/Users/Beerdosan/Documents/contrack-v2-e2e/backend/.data/files-e2e
SMS_PROVIDER=console
