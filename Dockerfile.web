# ─── contrack-web: the Next.js web app (build context = the repository root) ───
#   docker build -f Dockerfile.web -t contrack-web .
# Everything is read from env at run time (one image for any environment):
#   API_URL       backend address as this container reaches it (e.g. http://api:4000); /api/* is proxied there
#   REALTIME_URL  backend address as the BROWSER reaches it, for Socket.IO (e.g. https://api.dev.example.com)
# See docs/deploy/01-dev-docker.md.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx next build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    API_URL=http://api:4000 \
    REALTIME_URL=http://localhost:4000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- "http://127.0.0.1:${PORT}/app-config" >/dev/null || exit 1
CMD ["node", "server.js"]
