# Copy to .env and adjust. Every variable is validated at start-up (src/shared/infrastructure/config/env.ts).
NODE_ENV=development
PORT=4000

# postgres = real database (DATABASE_URL); memory = in-process store, for trying the API without a database
PERSISTENCE=postgres
DATABASE_URL=postgres://contrack:contrack@localhost:5432/contrack

# Realtime fan-out between instances: memory (single instance) or postgres (LISTEN/NOTIFY)
REALTIME_BUS=memory

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000
# true in production (HTTPS)
COOKIE_SECURE=false

# Integration tests only
TEST_DATABASE_URL=postgres://contrack:contrack@localhost:5432/contrack_test
