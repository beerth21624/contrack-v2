# Copy to .env and adjust. Every variable is validated at start-up (src/shared/infrastructure/config/env.ts).
NODE_ENV=development
PORT=4000

# postgres = real database (DATABASE_URL); memory = in-process store, for trying the API without a database
PERSISTENCE=postgres
DATABASE_URL=postgres://contrack:contrack@localhost:5432/contrack

# Realtime fan-out between instances: memory (single instance) or postgres (LISTEN/NOTIFY)
REALTIME_BUS=memory

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000
# true in production (HTTPS)
COOKIE_SECURE=false
# Path of the httpOnly refresh cookie as the browser sees it. The web app reaches the API through the Next rewrite
# /api/* -> backend, so the browser calls /api/auth/refresh. Use /auth when the browser talks to the API directly.
REFRESH_COOKIE_PATH=/api/auth
# Proxies whose X-Forwarded-For header is believed (the client address used by the per-IP rate limits of phone
# sign-in). Default loopback = only the Next server on the same machine. Comma separated: loopback, linklocal,
# uniquelocal, IP addresses or subnets (10.0.0.0/8); or a hop count (1); or false. `true` is refused (it would let any
# client choose its own address). If Next runs in another container / host, list that proxy's address or subnet.
# Production: the API must not be reachable directly from the internet, only through that proxy (bind it to a private
# network / firewall the port); a client that reaches it directly bypasses whatever the proxy enforces, and from inside
# a trusted subnet could even forge its address.
TRUST_PROXY=loopback

# Integration tests only
TEST_DATABASE_URL=postgres://contrack:contrack@localhost:5432/contrack_test

# Business modules the server offers (comma separated: subcontracting, materials, owner-leads, ai-assist). Empty = plain BOQ.
MODULES_ENABLED=subcontracting
# Public URL of the web app (links in SMS / LINE messages)
PUBLIC_APP_URL=http://localhost:3000
# Uploaded files: local (FILE_STORAGE_DIR) or memory
FILE_STORAGE=local
FILE_STORAGE_DIR=.data/files
# SMS for OTP and invitations: console (prints to the log) or thaibulksms (needs SMS_API_KEY / SMS_API_SECRET)
SMS_PROVIDER=console
# LINE OA channel access token (optional)
# LINE_CHANNEL_ACCESS_TOKEN=

# Decision model for the ai-assist module (Jev by TypeSafe AI). JEV_API_KEY is required when MODULES_ENABLED
# includes ai-assist; without a key the routes answer 503 ai_unavailable.
# JEV_API_KEY=
# JEV_MODEL=jev-1.14.0
# JEV_BASE_URL=https://jevtypesafeai.com/api/v1
